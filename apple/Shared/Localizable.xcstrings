{
  "sourceLanguage": "en",
  "strings": {
    "Account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号"
          }
        }
      }
    },
    "Activity name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动名称"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "An account with this email already exists. Sign in instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个邮箱已经注册过，请直接登录。"
          }
        }
      }
    },
    "another account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个账号"
          }
        }
      }
    },
    "Blue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝"
          }
        }
      }
    },
    "Can't reach the sync server. Hope will keep trying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上同步服务器，Hope 会自动重试。"
          }
        }
      }
    },
    "Can't sync right now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法同步"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Check %@ for a confirmation link, then sign in here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请到 %@ 查收确认邮件，点击链接后回到这里登录。"
          }
        }
      }
    },
    "Choose a longer password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码太短，请换一个更长的。"
          }
        }
      }
    },
    "Color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色"
          }
        }
      }
    },
    "Confirm your email first: check your inbox for the link.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在邮箱里点击确认链接。"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Connect Apple Watch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Apple Watch"
          }
        }
      }
    },
    "Create Account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
