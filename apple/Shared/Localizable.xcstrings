      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫"
          }
        }
      }
    },
    "Records on this device are merged into the account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备上的记录会合并进账号。"
          }
        }
      }
    },
    "Resume": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Sent to Apple Watch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送到 Apple Watch。"
          }
        }
      }
    },
    "Sign In": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录"
          }
        }
      }
    },
    "Sign Out": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录"
          }
        }
      }
    },
    "Signed out. Your records stay on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出登录，记录仍保留在这台设备上。"
          }
        }
      }
    },
    "Signing out keeps everything on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录不会删除这台设备上的数据。"
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出错了"
          }
        }
      }
    },
    "Something went wrong: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出错了：%@"
          }
        }
      }
    },
    "Start Something Else": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改记别的"
          }
        }
      }
    },
    "Start Timer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始计时"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束"
          }
        }
      }
    },
    "Sync Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步"
          }
        }
      }
    },
    "Syncing…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步中…"
          }
        }
      }
    },
    "Teal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "青"
          }
        }
      }
    },
    "This build has no sync server, so everything stays on this iPhone. See apple/README.md to turn sync on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本没有配置同步服务器，所有数据只保存在这台 iPhone 上。开启方法见 apple/README.md。"
          }
        }
      }
    },
    "This build has no sync server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本没有配置同步服务器。"
          }
        }
      }
    },
    "This device last synced with %@. Its records will be merged into %@. Nothing is deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备上次同步的是 %1$@。它的记录将合并进 %2$@，不会删除任何数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device last synced with %1$@. Its records will be merged into %2$@. Nothing is deleted."
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "Too many attempts. Try again in a few minutes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多，请过几分钟再试。"
          }
        }
      }
    },
    "Tracked": {
      "comment": "Under today's total on iPhone",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录"
          }
        }
      }
    },
    "Tracked today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天已记录"
          }
        }
      }
    },
    "Unknown activity": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知活动"
          }
        }
      }
    },
    "Use a Different Account?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到另一个账号？"
          }
        }
      }
    },
    "Wrong email or password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮箱或密码不正确。"
          }
        }
      }
    },
    "Yellow": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄"
          }
        }
      }
    },
    "Your sign-in has expired. Sign in again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期，请重新登录。"
          }
        }
      }
    }
  },
  "version": "1.0"
}