      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮箱"
          }
        }
      }
    },
    "Enter your password once more so the watch gets its own sign-in.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请再输入一次密码，让手表获得自己的登录。"
          }
        }
      }
    },
    "Gray": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灰"
