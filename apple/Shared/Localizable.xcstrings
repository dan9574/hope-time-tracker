    "Not configured": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置"
          }
        }
      }
    },
    "Not signed in.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录。"
          }
        }
      }
    },
    "Not signed in. Sign in on iPhone to sync.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录。在 iPhone 上登录即可同步。"
          }
        }
      }
    },
    "Nothing tracked yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没有记录"
          }
        }
      }
    },
    "now": {
      "comment": "End of a running record in the list, as in “09:00–now”",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在"
          }
        }
      }
