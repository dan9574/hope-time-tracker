<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Empty in a build without apple/Config/Supabase.generated.xcconfig. -->
	<key>HopeSupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>HopeSupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<!-- The App Group the complication snapshot is written to; empty in the launcher-only build. -->
	<key>HopeAppGroup</key>
	<string>$(HOPE_APP_GROUP)</string>
</dict>
</plist>
