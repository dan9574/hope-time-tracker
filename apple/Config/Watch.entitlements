<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared by the watch app and its complication extension. Used only when
	     HOPE_COMPLICATION_LIVE_DATA = YES (Base.xcconfig). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(HOPE_APP_GROUP)</string>
	</array>
</dict>
</plist>
